# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Anon key — used in the browser for Auth (signIn/signUp/signOut)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role — server-only, never expose to client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Analyst Expa — Google Gemini (inquiry agent). Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Optional; default gemini-1.5-flash. Alternatives: gemini-2.0-flash, gemini-1.5-pro
# GEMINI_INQUIRY_MODEL=gemini-1.5-flash
# Optional; max messages in context (default 60)
# GEMINI_INQUIRY_MAX_MESSAGES=60
